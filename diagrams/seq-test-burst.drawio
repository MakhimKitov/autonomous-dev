ry"><mxPoint x="2520" y="70" as="sourcePoint"/><mxPoint x="2520" y="1224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s7" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#8A8A8A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3000" y="70" as="sourcePoint"/><mxPoint x="3000" y="1224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s8" value="Control Plane (scheduler)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="160" height="42" as="geometry"/></mxCell><mxCell id="s9" value="Ledger (SQLite)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="520" y="24" width="160" height="42" as="geometry"/></mxCell><mxCell id="s10" value="GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="1000" y="24" width="160" height="42" as="geometry"/></mxCell><mxCell id="s11" value="Test Burst (container)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="1480" y="24" width="160" height="42" as="geometry"/></mxCell><mxCell id="s12" value="Claude API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="1960" y="24" width="160" height="42" as="geometry"/></mxCell><mxCell id="s13" value="Product Sandbox (test app + empty guild)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="2440" y="24" width="160" height="42" as="geometry"/></mxCell><mxCell id="s14" value="Human Owner" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#08427B;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="2985" y="20" width="30" height="46" as="geometry"/></mxCell><mxCell id="s15" value="Assess came back clean (APPROVE) → queue test" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=block;endFill=1;align=left;verticalAlign=middle;spacingLeft=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="116" as="sourcePoint"/><mxPoint x="120" y="142" as="targetPoint"/><Array as="points"><mxPoint x="174" y="116"/><mxPoint x="174" y="142"/></Array></mxGeometry></mxCell><mxCell id="s16" value="the funnel: no sandbox boot for a diff that's about to change; a pushed dev round re-queues assess first" style="shape=note;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="140" height="34" as="geometry"/></mxCell><mxCell id="s17" value="Read TESTING.md at the PR head" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="240" as="sourcePoint"/><mxPoint x="1080" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s18" value="the product's declared plug: frontmatter (env names, tools) for the platform, prose for the tester" style="shape=note;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="254" width="140" height="34" as="geometry"/></mxCell><mxCell id="s19" value="Env intersection: TEST_X provisioned ∧ manifest asks X → inject as X" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=block;endFill=1;align=left;verticalAlign=middle;spacingLeft=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="334" as="sourcePoint"/><mxPoint x="120" y="360" as="targetPoint"/><Array as="points"><mxPoint x="174" y="334"/><mxPoint x="174" y="360"/></Array></mxGeometry></mxCell><mxCell id="s20" value="the manifest is untrusted — a hostile request for anything outside TEST_* gets nothing" style="shape=note;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="348" width="140" height="34" as="geometry"/></mxCell><mxCell id="s21" value="Open test-burst row" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="458" as="sourcePoint"/><mxPoint x="600" y="458" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s22" value="Spawn test burst: TESTING.md prose + envelope prompt · FRESH session · clone ro at PR head · NO GitHub credential" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="508" as="sourcePoint"/><mxPoint x="1560" y="508" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s23" value="deliberately blind to the PR conversation — the dev cannot sweet-talk the tester" style="shape=note;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;" vertex="1" parent="1"><mxGeometry x="1490" y="522" width="140" height="34" as="geometry"/></mxCell><mxCell id="s24" value="Copy clone to scratch; boot the product" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=block;endFill=1;align=left;verticalAlign=middle;spacingLeft=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="602" as="sourcePoint"/><mxPoint x="1560" y="628" as="targetPoint"/><Array as="points"><mxPoint x="1614" y="602"/><mxPoint x="1614" y="628"/></Array></mxGeometry></mxCell><mxCell id="s25" value="Invent scenarios from the command reference + specs, weighted to the PR's diff" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="682" as="sourcePoint"/><mxPoint x="2040" y="682" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s26" value="Drive the running product E2E" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="732" as="sourcePoint"/><mxPoint x="2520" y="732" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s27" value="Observed behavior" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2520" y="782" as="sourcePoint"/><mxPoint x="1560" y="782" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s28" value="exit — structured report is the final message, returned via harvest" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="832" as="sourcePoint"/><mxPoint x="120" y="832" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s29" value="verdict + scenarios (pass/fail) + defects (preexisting?) + authored symptom issues" style="shape=note;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="846" width="140" height="34" as="geometry"/></mxCell><mxCell id="s30" value="Post as reviewer App: PR-caused defects → REQUEST_CHANGES review · clean → advisory comment" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="926" as="sourcePoint"/><mxPoint x="1080" y="926" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s31" value="a REQUEST_CHANGES report drives a normal dev round — same machinery, same caps" style="shape=note;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="940" width="140" height="34" as="geometry"/></mxCell><mxCell id="s32" value="Relay pre-existing defects as auto issues (≤3, deduped) — never ready" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="1020" as="sourcePoint"/><mxPoint x="1080" y="1020" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s33" value="the monitor's pipeline arriving early; the human gate authorizes all work" style="shape=note;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="1034" width="140" height="34" as="geometry"/></mxCell><mxCell id="s34" value="Close row; task → awaiting_review" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="1114" as="sourcePoint"/><mxPoint x="600" y="1114" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s35" value="🧪 report informs gate 2 (advisory, not a required check)" style="html=1;fontSize=10;align=center;verticalAlign=bottom;spacingBottom=2;strokeColor=#333333;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="1164" as="sourcePoint"/><mxPoint x="3000" y="1164" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>