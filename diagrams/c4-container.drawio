ead-only]" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2007" y="201" width="122" height="18" as="geometry"/></mxCell><mxCell id="__l3" value="Files issues (auto)" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1484" y="77" width="122" height="18" as="geometry"/></mxCell><mxCell id="__l4" value="Triage (ready label), review &amp; merge PRs" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1421" y="357" width="248" height="18" as="geometry"/></mxCell><mxCell id="__l5" value="Polls ready issues, assigns, tracks PRs [API]" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="831" y="255" width="278" height="18" as="geometry"/></mxCell><mxCell id="__l6" value="Spawns burst, injects task + session [Docker]" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="255" y="494" width="278" height="18" as="geometry"/></mxCell><mxCell id="__l7" value="Loads/saves sessions &amp; telemetry" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="294" y="568" width="200" height="18" as="geometry"/></mxCell><mxCell id="__l8" value="Clone, push branch, open PR [git/API]" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1146" y="273" width="230" height="18" as="geometry"/></mxCell><mxCell id="__l9" value="Agent loop [API]" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="918" y="494" width="104" height="18" as="geometry"/></mxCell><mxCell id=