<mxfile host="app.diagrams.net"><diagram name="Autonomous Maintenance Platform — Containers (C1)" id="c4drawio"><mxGraphModel dx="1400" dy="1000" grid="0" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="__bound" value="Autonomous Maintenance Platform — Containers (C1)" style="rounded=1;dashed=1;fillColor=none;strokeColor=#666666;fontColor=#666666;fontStyle=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;html=1;" vertex="1" parent="1"><mxGeometry x="-40" y="-50" width="1446" height="898" as="geometry"/></mxCell><mxCell id="g0" value="&lt;b&gt;Control Plane / Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Python service]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Triages→assigns ready issues, spawns burst containers, enforces budgets &amp; kill-switch, owns sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="0" y="465" width="209" height="94" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Dev Agent (burst worker)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Docker + claude-agent-sdk]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Per-burst: clone, branch, code, test, self-review, open PR; resumes session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="579" y="465" width="209" height="94" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;Monitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Python service · separate repo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Watches telemetry, files structured issues (auto provenance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="1157" y="0" width="209" height="94" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;Session &amp; Run Store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[S3 / Postgres]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Resumable Claude sessions + run telemetry / violations ledger, keyed by issue" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="579" y="714" width="209" height="94" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;Human Owner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Approves `ready` label, reviews &amp; merges PRs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="1157" y="328" width="209" height="94" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;Discord Users&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Untrusted message source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="1721" y="718" width="209" height="94" as="geometry"/></mxCell><mxCell id="g6" value="&lt;b&gt;Discord Bot — Product&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Maintained product, live in prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="2206" y="718" width="209" height="94" as="geometry"/></mxCell><mxCell id="g7" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Issues · PRs · branch protection · CI/CD]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Integration substrate / source of truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="1721" y="328" width="209" height="94" as="geometry"/></mxCell><mxCell id="g8" value="&lt;b&gt;Claude (Anthropic API)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[LLM]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Agent engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="1157" y="465" width="209" height="94" as="geometry"/></mxCell><mxCell id="g9" value="&lt;b&gt;Codex&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[AI reviewer]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Pre-PR review (in-container)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="1157" y="602" width="209" height="94" as="geometry"/></mxCell><mxCell id="g10" value="&lt;b&gt;GitHub Copilot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[AI reviewer]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Post-PR review on the PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="1157" y="826" width="209" height="94" as="geometry"/></mxCell><mxCell id="g11" value="&lt;b&gt;Product Telemetry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Logs / Metrics / Alertmanager]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Signals from the live bot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="2635" y="718" width="209" height="94" as="geometry"/></mxCell><mxCell id="__e0" value="" style="html=1;curved=1;endArrow=block;" edge="1" parent="1" source="g5" target="g6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2008" y="765"/><mxPoint x="2114" y="765"/></Array></mxGeometry></mxCell><mxCell id="__e1" value="" style="html=1;curved=1;endArrow=block;dashed=1;" edge="1" parent="1" source="g6" target="g11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2478"