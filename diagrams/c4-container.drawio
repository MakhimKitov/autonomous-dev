<mxfile host="app.diagrams.net"><diagram name="Autonomous Maintenance Platform — Containers (C2) · MVP as built, 2026-07" id="c4drawio"><mxGraphModel dx="1400" dy="1000" grid="0" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="__bound" value="Autonomous Maintenance Platform — Containers (C2) · MVP as built, 2026-07" style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBorderColor=none;spacingTop=0;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;noLabel=0;labelPadding=0;allowArrows=0;connectable=0;expand=0;recursiveResize=0;editable=1;pointerEvents=0;absoluteArcSize=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="-40" y="416" width="1125" height="1094" as="geometry"/></mxCell><mxCell id="g0" value="&lt;b&gt;Control Plane / Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Python · reconciler]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Tick: observe GitHub → advance the task state machine → run one burst (serial). Rails: attempts, review rounds, daily ceiling, hard budget cap; kill switch; crash recovery" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="0" y="783" width="209" height="188" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Dev Burst&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Docker · dev image · role: dev]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Resumes the per-task session; clone rw; branch → code → test → open PR; replies in review threads (fix/reply/defer)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="836" y="1314" width="209" height="156" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;Reviewer Burst (assess)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[same image · role: reviewer]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Fresh session; clone read-only at PR head; NO GitHub credential — findings return via harvest" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="836" y="1131" width="209" height="140" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;Test Burst (tester)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[same image · role: tester]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Fresh session; NO GitHub credential; boots the product from the PR head, invents scenarios from TESTING.md + specs, runs them E2E" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="836" y="932" width="209" height="156" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;Ledger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[SQLite · data/ledger.db]&lt;/font&gt;&lt;br&gt;&lt;br&gt;tasks · bursts · violations: status, attempts, rounds, review cursor, session ids" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="836" y="466" width="209" height="152" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;Session Archive&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[filesystem · data/sessions + volumes]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Task-keyed resumable transcripts; burst volumes kept for forensics. (Postgres + SeaweedFS = the designed scale-up, not built)" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="836" y="705" width="209" height="184" as="geometry"/></mxCell><mxCell id="g6" value="&lt;b&gt;Human Owner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;ready label (gate 1); review + merge (gate 2, CODEOWNERS)" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="1987" y="741" width="209" height="170" as="geometry"/></mxCell><mxCell id="g7" value="&lt;b&gt;End Users&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Untrusted content source" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="2554" y="654" width="209" height="138" as="geometry"/></mxCell><mxCell id="g8" value="&lt;b&gt;Product&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[first instance: Discord bot]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Maintained product; own repo, own CI" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="3034" y="578" width="209" height="108" as="geometry"/></mxCell><mxCell id="g9" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Issues · PRs · branch protection · CI]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Integration substrate / source of truth for task + delivery state" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2554" y="472" width="209" height="140" as="geometry"/></mxCell><mxCell id="g10" value="&lt;b&gt;Claude (Anthropic)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[owner-subscription OAuth]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Engine for all three burst roles" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1987" y="1224" width="209" height="108" as="geometry"/></mxCell><mxCell id="g11" value="&lt;b&gt;GitHub Copilot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[optional review provider]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Requested per PR on the owner's PAT (echo-verified — App tokens are silently dropped)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1987" y="472" width="209" height="140" as="geometry"/></mxCell><mxCell id="g12" value="&lt;b&gt;Product Sandbox&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[test Discord app + empty guild]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Disposable by construction; creds provisioned platform-side under TEST_*, injected into tester bursts only" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1987" y="954" width="209" height="140" as="geometry"/></mxCell><mxCell id="g13" value="&lt;b&gt;Monitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[phase 1+ — NOT BUILT]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Will file auto issues from prod telemetry; the tester's symptom relay already exercises that pipeline" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1987" y="289" wid