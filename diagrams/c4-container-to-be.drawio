<mxfile host="app.diagrams.net"><diagram name="Autonomous Maintenance Platform — Containers (C2) · TO-BE target, org-wide" id="c4drawio"><mxGraphModel dx="1400" dy="1000" grid="0" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="__bound" value="Autonomous Maintenance Platform — Containers (C2) · TO-BE target, org-wide" style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBorderColor=none;spacingTop=0;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;noLabel=0;labelPadding=0;allowArrows=0;connectable=0;expand=0;recursiveResize=0;editable=1;pointerEvents=0;absoluteArcSize=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="565" y="85" width="3076" height="1522" as="geometry"/></mxCell><mxCell id="g0" value="&lt;b&gt;Control Plane&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[k8s Deployment · leader-elected reconciler]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Per-task state machines; fair share across products × token availability; rails at burst/task/product/subscription/org level; webhook wake-up, poll for truth" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1187" y="768" width="209" height="188" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Burst Runners&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[k8s Jobs · microVM runtime (Kata / e2b — DR) · dev / reviewer / tester]&lt;/font&gt;&lt;br&gt;&lt;br&gt;One Job per burst; warm image per product family; no k8s API, egress allowlist; session materialized before boot, harvested after" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1931" y="540" width="209" height="172" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;Webhook Receiver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[stateless · behind ingress · the ONLY public surface]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Verifies HMAC per App secret, dedups by delivery id, emits wake events — holds no other credential; forgery ≤ one extra poll" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="3392" y="217" width="209" height="172" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;Console + CLI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[web GUI · live · Fermata SSO]&lt;/font&gt;&lt;br&gt;&lt;br&gt;LIVE fleet state + streaming burst logs (SSE/WS); task timelines, usage per subscription, violations feed, memory browser; audited operator actions" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="605" y="350" width="209" height="172" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;Monitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[k8s Deployment · per-product watchers · wave T4]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Files structured auto issues from telemetry (integration-breakage detectors first); rate-limited, behind the ready gate" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1931" y="135" width="209" height="172" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;Ledger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Postgres]&lt;/font&gt;&lt;br&gt;&lt;br&gt;tasks · bursts · violations + products, quotas, subscriptions, audit log — same protocol as the MVP's SQLite" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1931" y="778" width="209" height="168" as="geometry"/></mxCell><mxCell id="g6" value="&lt;b&gt;Session Archive&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[S3-compatible object store]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Task-keyed resumable transcripts, checksummed; retention policy applies here" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1931" y="1022" width="209" height="152" as="geometry"/></mxCell><mxCell id="g7" value="&lt;b&gt;Platform Memory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[per-product namespaces · provenance on every entry]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Product + platform tiers; written only via harvest (agent proposes), read only via prompt assembly as auto-class data; gardener + human browser" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1931" y="1351" width="209" height="216" as="geometry"/></mxCell><mxCell id="g8" value="&lt;b&gt;Observability&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[OTel collector → org backend]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Trace-per-burst, task correlation; feeds the console's live streams and the standing dashboards; agents emit, never read" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2726" y="273" width="209" height="156" as="geometry"/></mxCell><mxCell id="g9" value="&lt;b&gt;Product Teams&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person · per repo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Own both gates in GitHub: ready label + review &amp; merge; watch their products live in the console; contribute subscriptions to the pool" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="0" y="33" width="209" height="202" as="geometry"/></mxCell><mxCell id="g10" value="&lt;b&gt;Platform Team&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Registers products, sets quotas, manages the pool, handles incidents — through the console, never SQL" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="0" y="343" width="209" height="186" as="geometry"/></mxCell><mxCell id="g11" value="&lt;b&gt;GitHub (Fermata org)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[4 org Apps: dev · reviewer · tester · monitor]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Issues, PRs, reviews, branch protection, CI — per-repo-scoped tokens minted per burst" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2726" y="472" width="209" height="156" as="geometry"/></mxCell><mxCell id="g12" value="&lt;b&gt;Product Repos ×N&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[fermata/* · own CI]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Each carries its contracts: CLAUDE.md + TESTING.md (socket and plug)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="3392" y="950" width="209" height="124" as="geometry"/></mxCell><mxCell id="g13" value="&lt;b&gt;Product Sandboxes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[per product · declared · disposable]&lt;/font&gt;&lt;br&gt;&lt;br&gt;TEST_* creds from the secret manager, injected into tester bursts only" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2726" y="1044" width="209" height="124" as="geometry"/></mxCell><mxCell id="g14" value="&lt;b&gt;Claude (Anthropic)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[team subscription pool — NOT API billing]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Opt-in member tokens with usage caps; rate-limit-aware rotation; every burst attributed to its subscription" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2726" y="845" width="209" height="156" as="geometry"/></mxCell><mxCell id="g15" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Vault / External Secrets]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Platform creds + registered subscription tokens + per-product TEST_* sets; injected at spawn, never archived" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2726" y="1568" width="209" height="140" as="geometry"/></mxCell><mxCell id="g16" value="&lt;b&gt;Slack&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[per-team channels]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Ball-is-with-you nudges + budget/violation alerts; deep links only, never actionable" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2726" y="1385" width="209" height="140" as="geometry"/></mxCell><mxCell id="g17" value="&lt;b&gt;Org Telemetry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[logs · metrics · Alertmanager]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Existing signals from running products; the monitor's input" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="3785" y="950" width="209" height="124" as="geometry"/></mxCell><mxCell id="__e0" value="" style="html=1;curved=1;endArrow=block;exitX=1.000;exitY=0.411;exitDx=0;exitDy=0;entryX=0.033;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g9" target="g11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="329" y="97"/><mxPoint x="532" y="70"/><mxPoint x="708" y="70"/><mxPoint x="708" y="70"/><mxPoint x="708" y="70"/><mxPoint x="2036" y="70"/><mxPoint x="2319" y="70"/><mxPoint x="2461" y="-45"/><mxPoint x="2668" y="149"/><mxPoint x="2768" y="242"/><mxPoint x="2661" y="331"/><mxPoint x="2726" y="451"/><mxPoint x="2728" y="454"/><mxPoint x="2730" y="458"/></Array></mxGeometry></mxCell><mxCell id="__e1" value="" style="html=1;curved=1;endArrow=block;exitX=1.000;exitY=0.752;exitDx=0;exitDy=0;entryX=0.000;entryY=0.163;entryDx=0;entryDy=0;" edge="1" pare