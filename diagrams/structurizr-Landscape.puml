@startuml
title <size:24>System Landscape View</size>\n<size:24>C0 (ecosystem) — the whole experiment</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

Person(HumanOwner, "Human Owner", $descr="Triages issues (ready label), reviews & merges PRs, deploys prod.", $tags="", $link="")
System(ClaudeAnthropicAPI, "Claude (Anthropic API)", $descr="LLM engine behind the dev agent & monitor.", $tags="", $link="")
System(Codex, "Codex", $descr="Independent pre-PR code reviewer (runs in-container).", $tags="", $link="")
System(GitHubCopilot, "GitHub Copilot", $descr="Independent post-PR code reviewer (on the PR).", $tags="", $link="")
System(ProductTelemetry, "Product Telemetry", $descr="Logs, metrics & Alertmanager signals from the live bot.", $tags="", $link="")
Person(DiscordUsers, "Discord Users", $descr="Real users of the product; their messages are untrusted input.", $tags="", $link="")
System(AutonomousMaintenancePlatform, "Autonomous Maintenance Platform", $descr="Runs autonomous AI developers that maintain the product through GitHub.", $tags="", $link="")
System(DiscordBotProduct, "Discord Bot — Product", $descr="The maintained product; live in prod with real traffic.", $tags="", $link="")
System(GitHub, "GitHub", $descr="Issues, PRs, branch protection, CI/CD — the integration substrate / source of truth.", $tags="", $link="")

Rel(HumanOwner, GitHub, "Triages (ready label), reviews & merges PRs", $techn="", $tags="", $link="")
Rel(DiscordUsers, DiscordBotProduct, "Send messages", $techn="Discord", $tags="", $link="")
Rel(AutonomousMaintenancePlatform, GitHub, "Polls ready issues, assigns, tracks PRs", $techn="API", $tags="", $link="")
Rel(AutonomousMaintenancePlatform, ClaudeAnthropicAPI, "Drives the agent loop", $techn="API", $tags="", $link="")
Rel(AutonomousMaintenancePlatform, Codex, "Pre-PR self-review", $techn="", $tags="", $link="")
Rel(AutonomousMaintenancePlatform, ProductTelemetry, "Watches", $techn="read-only", $tags="", $link="")
Rel(GitHubCopilot, GitHub, "Reviews PRs", $techn="", $tags="", $link="")
Rel(GitHub, DiscordBotProduct, "CI tests & deploys on merge", $techn="", $tags="", $link="")
Rel(DiscordBotProduct, ProductTelemetry, "Emits logs / metrics", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml