  <diagram id="data-model-to-be" name="Data model TO-BE">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Autonomous Maintenance Platform — Data model · TO-BE block 1 (the state block), 2026-07&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GitHub owns task &amp;amp; delivery state · Postgres owns run + org state (Ledger protocol) · the object store owns transcripts (SessionArchive protocol) · tokens stay in the secret manager — correlated by ids, never mirrored · (new) = lands empty in block 1, filled by later blocks&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="bGithub" value="GITHUB — task + delivery state, referenced by id · unchanged" style="rounded=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=bottom;align=left;spacingLeft=8;fontSize=10;fontColor=#666666;html=1;" vertex="1" parent="1">
          <mxGeometry x="25" y="80" width="300" height="590" as="geometry" />
        </mxCell>
        <mxCell id="bLedger" value="POSTGRES LEDGER — run + org state · same Ledger protocol, real types (was SQLite: data/ledger.db)" style="rounded=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=bottom;align=left;spacingLeft=8;fontSize=10;fontColor=#6c8ebf;html=1;" vertex="1" parent="1">
          <mxGeometry x="415" y="80" width="710" height="1440" as="geometry" />
        </mxCell>
