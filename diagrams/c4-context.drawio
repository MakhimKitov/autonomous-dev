<mxfile host="app.diagrams.net"><diagram name="Autonomous Maintenance Platform — System Context (C0)" id="c4drawio"><mxGraphModel dx="1400" dy="1000" grid="0" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="__bound" value="Autonomous Maintenance Platform — System Context (C0)" style="rounded=1;dashed=1;fillColor=none;strokeColor=#666666;fontColor=#666666;fontStyle=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;html=1;" vertex="1" parent="1"><mxGeometry x="-40" y="-10" width="289" height="184" as="geometry"/></mxCell><mxCell id="g0" value="&lt;b&gt;Autonomous Maintenance Platform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Runs autonomous AI developers that maintain the product through GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="209" height="94" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Human Owner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Triages issues, reviews &amp; merges PRs, deploys prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="0" y="177" width="209" height="94" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;Discord Users&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Real users; their messages are untrusted input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="595" y="314" width="209" height="94" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;Discord Bot — Product&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Software System]&lt;/fo