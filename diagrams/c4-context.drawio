<mxfile host="app.diagrams.net"><diagram name="Autonomous Maintenance Platform — System Context (C1) · MVP as built, 2026-07" id="c4drawio"><mxGraphModel dx="1400" dy="1000" grid="0" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="__bound" value="Autonomous Maintenance Platform — System Context (C1) · MVP as built, 2026-07" style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBorderColor=none;spacingTop=0;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;noLabel=0;labelPadding=0;allowArrows=0;connectable=0;expand=0;recursiveResize=0;editable=1;pointerEvents=0;absoluteArcSize=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="-40" y="647" width="289" height="262" as="geometry"/></mxCell><mxCell id="g0" value="&lt;b&gt;Autonomous Maintenance Platform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Runs an autonomous developer, machine reviewers and an E2E tester as ephemeral bursts; two human gates bracket the loop" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="0" y="697" width="209" height="172" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Human Owner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Triages issues (ready), reviews PRs, merges — the only identity that can merge" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="0" y="317" width="209" height="170" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;End Users&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Real users; their content is untrusted data, never instructions" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="910" y="0" width="209" height="170" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;Product&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Software System · first instance: Discord bot]&lt;/font&gt;&lt;br&gt;&lt;br&gt;The maintained product; deploys via its own CI on human merge" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1391" y="159" width="209" height="140" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Issues = queue · PRs = delivery + review · branch protection = human gate · CI" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="910" y="340" width="209" height="124" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;Claude (Anthropic)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[owner-subscription OAuth]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Agent engine for dev, reviewer and tester bursts" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="910" y="872" width="209" height="108" as="geometry"/></mxCell><mxCell id="g6" value="&lt;b&gt;GitHub Copilot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[optional review provider]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Extra machine reviewer, requested per PR on the owner's PAT" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="0" y="530" width="209" height="124" as="geometry"/></mxCell><mxCell id="g7" value="&lt;b&gt;Product Sandbox&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[disposable · first instance: test Discord app + empty guild]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Where the tester drives the running product E2E" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="910" y="705" width="209" height="124" as="geometry"/></mxCell><mxCell id="g8" value="&lt;b&gt;Monitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[phase 1+ — NOT BUILT]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Will watch prod telemetry and file auto issues; the tester already feeds that pipeline" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="0" y="134" width="209" height="140" as="geometry"/></mxCell><mxCell id="__e0" value="" style="html=1;curved=1;endArrow=block;exitX=1.000;exitY=0.682;exitDx=0;exitDy=0;entryX=0.000;entryY=0.250;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1196" y="139"/><mxPoint x="1300" y="171"/></Array></mxGeometry></mxCell><mxCell id="__e1" value="" style="html=1;curved=1;endArrow=block;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target="g4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="402"/><mxPoint x="720" y="402"/></Array></mxGeometry></mxCell><mxCell id="__e2" value="" style="html=1;curved=1;endArrow=block;exitX=1.000;exitY=0.349;exitDx=0;exitDy=0;entryX=0.263;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g0" target="g4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="408" y="706"/><mxPoint x="824" y="600"/><mxPoint x="852" y="582"/><mxPoint x="897" y="555"/><mxPoint x="936" y="511"/></Array></mxGeometry></mxCell><mxCell id="__e3" value="" style="html=1;curved=1;endArrow=block;exitX=1.000;exitY=0.593;exitDx=0;exitDy=0;entryX=0.000;entryY=0.333;entryDx=0;entryDy=0;" edge="1" parent="1" source="g0" target="g5"><mxGeometry relative="1" as="geometry"><Array